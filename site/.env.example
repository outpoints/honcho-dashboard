# Default Honcho base URL used when the dashboard has no saved instance.
# Override per-instance in the Config page (stored in localStorage).
NEXT_PUBLIC_HONCHO_BASE_URL=http://localhost:8000

# Optional default bearer token. Leave empty if AUTH_USE_AUTH=false on the server.
NEXT_PUBLIC_HONCHO_TOKEN=

# Server-side proxy allowlist (comma-separated origins, scheme+host+port).
# Required for multi-instance support. NEXT_PUBLIC_HONCHO_BASE_URL is implicitly
# allowed if set; add additional Honcho hosts here.
#   HONCHO_PROXY_ALLOWED_BASES=http://honcho.local:8000,https://honcho.prod.example.com
HONCHO_PROXY_ALLOWED_BASES=

# ---- Operator modules (self-hosted runtime / db / config / logs / diagnostics) ----
# These power the panels that Honcho's REST API does not expose. Each is optional;
# unset values cause the corresponding UI panel to render an honest "not configured"
# state instead of fake data. Honcho itself is never modified.

# Read-only Postgres DSN — point at the SAME database Honcho uses.
# Enables: db size, pgvector status, table sizes, throughput chart, conclusion heatmap.
HONCHO_DATABASE_URL=

# Tail this log file in the Diagnostics page.
HONCHO_LOG_FILE=

# ISO-8601 timestamp of when the Honcho server process started.
# When set, the Instance page reports a Honcho uptime alongside dashboard uptime.
HONCHO_RUNTIME_START_TS=

# Extra env keys to expose on the operator/config endpoint (comma-separated).
# Defaults already include the keys above plus NODE_ENV.
HONCHO_OPERATOR_CONFIG_KEYS=
