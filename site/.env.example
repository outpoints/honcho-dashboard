# Default Honcho base URL used when the dashboard has no saved instance.
# Override per-instance in the Config page (stored in localStorage).
NEXT_PUBLIC_HONCHO_BASE_URL=http://localhost:8000

# Optional default bearer token. Leave empty if AUTH_USE_AUTH=false on the server.
NEXT_PUBLIC_HONCHO_TOKEN=

# Server-side proxy allowlist (comma-separated origins, scheme+host+port).
# Required for multi-instance support. NEXT_PUBLIC_HONCHO_BASE_URL is implicitly
# allowed if set; add additional Honcho hosts here.
#   HONCHO_PROXY_ALLOWED_BASES=http://honcho.local:8000,https://honcho.prod.example.com
HONCHO_PROXY_ALLOWED_BASES=

# Optional server-side bearer token the proxy sends to the default Honcho base URL
# (NEXT_PUBLIC_HONCHO_BASE_URL / HONCHO_PROXY_BASE_URL) when a request carries none.
# Applies only to that URL and never reaches the browser. Anyone who can reach the
# dashboard can use it through the proxy, so whenever this is set also set
# DASHBOARD_PASSWORD (or keep the dashboard on a private network). Only used for
# requests that name their target with X-Honcho-Base-Url, which every dashboard
# call does. A value with a line break or other invalid header character is
# ignored, with a warning.
HONCHO_PROXY_TOKEN=

# ---- Operator modules (self-hosted runtime / db / config / logs / diagnostics) ----
# These power the panels that Honcho's REST API does not expose. Each is optional;
# unset values cause the corresponding UI panel to render an honest "not configured"
# state instead of fake data. The dashboard only reads through the operator DB connection except the opt-in HONCHO_OPERATOR_WRITES retry action.

# Postgres DSN — point at the SAME database Honcho uses. The dashboard only reads
# through it unless HONCHO_OPERATOR_WRITES (below) is enabled; while it is off,
# the connection is opened with default_transaction_read_only=on (a pooler that
# refuses that startup option, PgBouncer before 1.26, is reconnected without it,
# with one warning; writes stay refused in code). A read-only role is still
# recommended.
# Enables: db size, pgvector status, table sizes, throughput chart, conclusion heatmap.
HONCHO_DATABASE_URL=

# Opt-in (1/true/yes): allow retrying failed reasoning tasks. This is the only
# direct database write: UPDATE on Honcho's `queue` table, so the DB role
# needs UPDATE on `queue`. Unset = writes refused with HTTP 403. Requests to the
# endpoint must carry the header `X-Honcho-Dashboard: 1` (the UI sends it).
HONCHO_OPERATOR_WRITES=

# Tail this log file in the Diagnostics page.
HONCHO_LOG_FILE=

# Collector CloudEvents JSONL export, separate from ordinary logs.
# Diagnostics reads bounded metadata only; this is a dashboard-host source.
HONCHO_TRACE_FILE=

# ISO-8601 timestamp of when the Honcho server process started.
# When set, the Instance page reports a Honcho uptime alongside dashboard uptime.
HONCHO_RUNTIME_START_TS=

# Extra env keys to expose on the operator/config endpoint (comma-separated).
# Defaults already include the keys above plus NODE_ENV.
HONCHO_OPERATOR_CONFIG_KEYS=

# ---- Optional dashboard login ----
# Changing the password or the secret ends every existing session.
# Leave DASHBOARD_PASSWORD empty for no authentication. When set, every API route and the
# /v3, /health and /openapi.json passthroughs require a login cookie.
# DASHBOARD_SESSION_SECRET is REQUIRED when the password is set (>= 32 chars, no default):
#   openssl rand -base64 48
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Session lifetime in hours (default 168). Lowering it also shortens existing sessions.
DASHBOARD_SESSION_TTL_HOURS=
# Reverse proxies in front of the dashboard (default 1); picks the client address for the
# login rate limiter from the right of X-Forwarded-For.
DASHBOARD_TRUSTED_PROXIES=
