# Honcho Self-Hosted Dashboard — example .env for docker compose
#
# Copy to `.env` next to docker-compose.yml and fill in values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up --build -d
#
# The Next.js app inside `site/` has its own `.env.example` for `npm run dev`
# workflows — this file is for the docker-compose deployment.

# =====================================================================
# REQUIRED
# =====================================================================

# Upstream Honcho instance the dashboard talks to. Inlined into the
# browser bundle at build time AND read by the server-side proxy at runtime.
# Example:
#   HONCHO_BASE_URL=http://honcho.local:8000
HONCHO_BASE_URL=http://localhost:8000

# Server-side proxy allowlist (comma-separated origins, scheme+host+port).
# The proxy fails closed when this is empty AND no HONCHO_BASE_URL is set.
# In single-instance setups, set this to the same value as HONCHO_BASE_URL.
# Example:
#   HONCHO_PROXY_ALLOWED_BASES=http://honcho.local:8000,https://honcho.prod.example.com
HONCHO_PROXY_ALLOWED_BASES=http://localhost:8000


# =====================================================================
# OPTIONAL — leave empty to skip; the corresponding UI panels will
# render an honest "not configured" state instead of fake data.
# =====================================================================

# Bearer token, if your Honcho server has AUTH_USE_AUTH=true.
HONCHO_TOKEN=

# Host port the dashboard listens on (defaults to 3000).
DASHBOARD_PORT=3000

# Read-only Postgres DSN to the SAME database Honcho uses. Enables the
# throughput chart, 52-week heatmap, db size / vector-count / top-tables
# on the Instance page, and the PostgreSQL diagnostic probe.
# Either of these prefixes works (the operator strips the +psycopg variant):
#   HONCHO_DATABASE_URL=postgresql://user:password@honcho.local:5432/honcho
#   HONCHO_DATABASE_URL=postgresql+psycopg://user:password@honcho.local:5432/honcho
HONCHO_DATABASE_URL=

# Path (inside the container) to a Honcho log file. Mount the real file via
# the `volumes:` block in docker-compose.yml so the container can read it.
# Enables: log tail panel on the Diagnostics page.
HONCHO_LOG_FILE=

# ISO-8601 timestamp of when your Honcho process started. When set, the
# Instance page can report a Honcho uptime alongside the dashboard's own.
# Example:
#   HONCHO_RUNTIME_START_TS=2026-05-22T03:38:00Z
HONCHO_RUNTIME_START_TS=

# Extra env keys to expose on the /api/operator/config endpoint (comma-
# separated). The standard set is always included; values matching
# /token|secret|password|key|api[_-]?key/i are automatically redacted.
HONCHO_OPERATOR_CONFIG_KEYS=
