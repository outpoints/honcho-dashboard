# Honcho Self-Hosted Dashboard — example .env for docker compose
#
# Copy to `.env` next to docker-compose.yml and fill in values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up --build -d
#
# The Next.js app inside `site/` has its own `.env.example` for `npm run dev`
# workflows — this file is for the docker-compose deployment.

# =====================================================================
# REQUIRED
# =====================================================================

# Upstream Honcho instance the dashboard talks to, read at runtime. The proxy
# uses it as its default and new browsers start on it. Use an address the
# dashboard container can reach; other devices only need to reach the dashboard.
# Example:
#   HONCHO_BASE_URL=http://honcho.local:8000
HONCHO_BASE_URL=http://localhost:8000

# Server-side proxy allowlist (comma-separated origins, scheme+host+port).
# The proxy fails closed when this is empty AND no HONCHO_BASE_URL is set.
# In single-instance setups, set this to the same value as HONCHO_BASE_URL.
# Example:
#   HONCHO_PROXY_ALLOWED_BASES=http://honcho.local:8000,https://honcho.prod.example.com
HONCHO_PROXY_ALLOWED_BASES=http://localhost:8000

# Optional bearer token the proxy sends to HONCHO_BASE_URL when a request carries
# none, so browsers need no token under CONFIG. Applies only to that default URL
# and never reaches the browser. Anyone who can reach the dashboard can use it
# through the proxy, so whenever this is set also set DASHBOARD_PASSWORD (or keep
# the dashboard on a private network). Only used for requests that name their
# target with X-Honcho-Base-Url, which every dashboard call does. A value with a
# line break or other invalid header character is ignored, with a warning.
HONCHO_PROXY_TOKEN=


# =====================================================================
# OPTIONAL — leave empty to skip; the corresponding UI panels will
# render an honest "not configured" state instead of fake data.
# =====================================================================

# Bearer token, if your Honcho server has AUTH_USE_AUTH=true.
HONCHO_TOKEN=

# Host port the dashboard listens on (defaults to 3000).
DASHBOARD_PORT=3000

# Postgres DSN to the SAME database Honcho uses. The dashboard only reads
# through it unless HONCHO_OPERATOR_WRITES (below) is enabled; while it is off,
# the connection is opened with default_transaction_read_only=on. A read-only
# role is still recommended. Enables the
# throughput chart, 52-week heatmap, db size / vector-count / top-tables
# on the Instance page, and the PostgreSQL diagnostic probe.
# Either of these prefixes works (the operator strips the +psycopg variant):
#   HONCHO_DATABASE_URL=postgresql://user:password@honcho.local:5432/honcho
#   HONCHO_DATABASE_URL=postgresql+psycopg://user:password@honcho.local:5432/honcho
HONCHO_DATABASE_URL=

# Opt-in: allow the dashboard to retry failed reasoning tasks. This is the only
# direct database write: UPDATE on Honcho's `queue` table, so the role in
# HONCHO_DATABASE_URL needs UPDATE on `queue`. Truthy values: 1, true, yes.
# Unset (default) = the server refuses these writes with HTTP 403. Requests to
# the endpoint must carry the header `X-Honcho-Dashboard: 1` (the UI sends it).
HONCHO_OPERATOR_WRITES=

# Path (inside the container) to a Honcho log file. Mount the real file via
# the `volumes:` block in docker-compose.yml so the container can read it.
# Enables: log tail panel on the Diagnostics page.
HONCHO_LOG_FILE=

# Optional collector export of Honcho CloudEvents call traces (JSONL).
# Mount this separately from ordinary logs; the path is inside the container.
HONCHO_TRACE_FILE=

# ISO-8601 timestamp of when your Honcho process started. When set, the
# Instance page can report a Honcho uptime alongside the dashboard's own.
# Example:
#   HONCHO_RUNTIME_START_TS=2026-05-22T03:38:00Z
HONCHO_RUNTIME_START_TS=

# Extra env keys to expose on the /api/operator/config endpoint (comma-
# separated). The standard set is always included; values matching
# /token|secret|password|key|api[_-]?key/i are automatically redacted.
HONCHO_OPERATOR_CONFIG_KEYS=

# Optional dashboard login. Leave DASHBOARD_PASSWORD empty for no authentication.
# Changing the password or the secret ends every existing session.
# When set, DASHBOARD_SESSION_SECRET is REQUIRED (>= 32 chars; there is no default).
# Generate one with:  openssl rand -base64 48
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days). Lowering it also shortens existing sessions.
DASHBOARD_SESSION_TTL_HOURS=
# Reverse proxies in front of the dashboard (default 1); picks the client address for the
# login rate limiter from the right of X-Forwarded-For.
DASHBOARD_TRUSTED_PROXIES=
