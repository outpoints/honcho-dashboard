# Repo-root ignores. Site-specific ignores live in site/.gitignore.

# Local environment for docker compose (committed example is .env.example).
.env
.env.local
.env.*.local

# Local docker compose file (committed template is docker-compose-example.yml).
docker-compose.yml

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Session handoff notes — local only, never committed.
HANDOFF.md
HANDOFF_PROMPT.md

# Impeccable live-mode session journals (local runtime state).
.impeccable/live/sessions/
